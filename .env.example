# Copy to .env and fill in local paths. All code reads paths from here; nothing
# is hardcoded, so the .env is the only file with machine-specific paths.
MODELS_ROOT=/path/to/models              # dir of local model folders (names match --model)
DATASETS_ROOT=/path/to/hf_datasets_hub   # HuggingFace datasets hub cache
EXP_ROOT=/path/to/experiment_outputs     # all caches, results, and logs land here
HF_CACHE=/path/to/hf_cache               # HuggingFace home (HF_HOME defaults to this)
